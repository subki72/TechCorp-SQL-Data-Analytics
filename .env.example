# TechCorp SQL Data Analytics Environment Configuration
# Copy this file to .env and adjust values for local or container runs.

TECHCORP_DB_PATH=techcorp_db.sqlite
TECHCORP_LOG_LEVEL=INFO
TECHCORP_API_HOST=127.0.0.1
TECHCORP_API_PORT=8000
TECHCORP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
TECHCORP_REQUEST_TIMEOUT_SECONDS=10.0
TECHCORP_SENIOR_CUTOFF_DATE=2021-01-01
TECHCORP_CACHE_TTL_SECONDS=60.0
TECHCORP_RATE_LIMIT_REQUESTS=120
TECHCORP_RATE_LIMIT_WINDOW_SECONDS=60.0
